# Copy these names into the deployment's secret/environment manager.
# Never commit real token values.
BTC_ADMIN_TOKEN=replace-with-a-random-secret-at-least-16-characters
BTC_CONTROL_TOKEN=replace-with-a-different-random-secret-at-least-16-characters
BTC_ALLOWED_ORIGINS=https://btc.example.com
BTC_BIND_HOST=127.0.0.1
BTC_ALLOW_PUBLIC_BIND=0
BTC_DATA_DIR=/home/ubuntu/quant-app/data

# Safe production posture.
BTC_DEPLOYMENT_ENV=production
BTC_REQUIRE_ADMIN_TOKEN=1
BTC_STRICT_ARTIFACT_IDENTITY=1
BTC_FREEZE_MODEL=1
BTC_RUN_STARTUP_BACKTEST=0
BTC_FORCE_MAIN_RETRAIN=0
BTC_FORCE_HEAD_RETRAIN=0
BTC_OVERNIGHT_TRAIN_ALL=0
BTC_SKIP_BACKFILL=1
BTC_SERVE_FRONTEND=1
BTC_EVIDENCE_MODE=1
BTC_REQUIRE_COMPLETE_TRADE=1
# Oracle serves a frozen local model. It only warms a small live-candle window, while artifact
# identity remains bound to the full training window used on the Windows training machine.
BTC_HISTORICAL_DAYS=3
BTC_MODEL_TRAINING_DAYS=1000
BTC_REQUIRE_POLYMARKET_FEED=1
BTC_REQUIRE_PROTOCOL_HEALTH=1
BTC_LOG_DIR=/home/ubuntu/quant-app/data/logs
BTC_LOG_MAX_MB=20
BTC_LOG_BACKUP_COUNT=10
BTC_ENABLE_LIVE_TRADING=0
BTC_ENABLE_REAL_ORDERS=0
BTC_BINANCE_LIVE=0
BTC_POLYMARKET_LIVE=0
